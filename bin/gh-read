#!/bin/sh
# Reads another repository with a read-only review token, so Claude never has to write a
# $VARIABLE in a command (its permission checker rejects those).
# Usage: gh-read repos/<owner>/<repo>/... [gh api flags]
#
# redbubble and teepublic repositories are read with that organisation's token. Any other owner's
# repository is read with the redbubble token, and only if it's public: upstream changelogs and
# release notes, for example. Locally that token is the engineer's own, which may see private
# repositories elsewhere, so gh-read checks the repository's visibility first.
#
# Only GET requests: local reviews (scripts/run-local.sh) give it the engineer's own token, which
# can usually write. So it allows only the flags below and refuses everything else, including
# grouped short flags (`-iX POST`), which gh would read as -i plus -X POST.
#
# Nothing a read could signal through: a review only needs metadata, file contents, diffs and
# release notes. Outside redbubble and teepublic, it refuses release-asset downloads, whose public
# download counts would let an injected prompt send data to whoever owns the repository, one asset
# at a time. -H only sets an Accept header for a GitHub JSON, raw, diff or patch response, so no
# request can ask for a binary download. A --jq program can't read the environment (`env`,
# `$ENV`), where the review's tokens and API key are.
set -eu
refuse() {
  echo "gh-read: $*" >&2
  exit 2
}
path="${1:-}"
# No `..` or percent-encoding, which could move the request out of the repository it names.
case "$path" in
  *..* | *%*) refuse "the path can't contain .. or %" ;;
esac
rest=${path#/}
case "$rest" in
  repos/*/*) ;;
  *) refuse "the path must start with repos/<owner>/<repo>" ;;
esac
rest=${rest#repos/}
owner=${rest%%/*}
repo=${rest#*/}
repo=${repo%%/*}
repo=${repo%%\?*}
name_ok() {
  case "$1" in
    '' | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}
if ! name_ok "$owner" || ! name_ok "$repo"; then
  refuse "the path must start with repos/<owner>/<repo>"
fi
case "$owner" in
  redbubble) GH_TOKEN="$RB_READ_TOKEN" ;;
  teepublic) GH_TOKEN="$TP_READ_TOKEN" ;;
  *) GH_TOKEN="$RB_READ_TOKEN" public_only=yes ;;
esac
export GH_TOKEN
if [ "${public_only:-}" = yes ]; then
  # Lower case and single slashes, so no spelling of the path gets past the check.
  normalized=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]' | tr -s /)
  case "$normalized" in
    */releases/assets | */releases/assets/* | */releases/assets\?*)
      refuse "release assets can't be downloaded outside redbubble and teepublic: read the release itself (releases/tags/<tag>) for its notes"
      ;;
  esac
fi
check_header() {
  printf '%s' "$1" | grep -Eiq '^accept:[[:space:]]*application/(json|vnd\.github(\.v3)?(\.(raw|diff|patch|text|html|full))?(\+json)?)[[:space:]]*$' ||
    refuse "-H only takes an Accept header for a GitHub JSON, raw, diff or patch response, such as 'Accept: application/vnd.github.raw'"
}
check_jq() {
  if printf '%s' "$1" | grep -Eq '(^|[^A-Za-z0-9_])(env|ENV)($|[^A-Za-z0-9_])'; then
    refuse "a --jq program can't read the environment"
  fi
}
expect=
shift
for arg in "$@"; do
  case "$expect" in
    method) [ "$arg" = GET ] || refuse "only GET requests" ;;
    header) check_header "$arg" ;;
    jq) check_jq "$arg" ;;
  esac
  if [ -n "$expect" ]; then
    expect=
    continue
  fi
  case "$arg" in
    -H | --header) expect=header ;;
    -q | --jq) expect=jq ;;
    -t | --template | --cache) expect=value ;;
    -X | --method) expect=method ;;
    --header=*) check_header "${arg#--header=}" ;;
    --jq=*) check_jq "${arg#--jq=}" ;;
    --template=* | --cache=* | --method=GET | -XGET) ;;
    -i | --include | --paginate | --slurp | --silent) ;;
    *) refuse "$arg isn't allowed: only -H, --jq, --template, --cache, -i, --paginate, --slurp, --silent and -X GET, each on its own" ;;
  esac
done
[ -z "$expect" ] || refuse "the last flag needs a value"
if [ "${public_only:-}" = yes ]; then
  visibility=$(gh api "repos/$owner/$repo" --jq .visibility 2> /dev/null) || visibility=
  [ "$visibility" = public ] ||
    refuse "$owner/$repo isn't a public repository, or doesn't exist: outside redbubble and teepublic, only public repositories can be read"
fi
exec gh api "$path" "$@"
